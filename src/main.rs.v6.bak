//! 命令行入口：`run` / `check` / `dump` / `--dump-config`。

use std::path::{Path, PathBuf};

use anyhow::{Context, Result};
use clap::{ArgAction, Parser, Subcommand};
use asus_numpad::config::{
    self, CalcMode, Config, MixedMode, NumLockMode, MANUAL_BRIGHTNESS_STEPS, VAL_OFF,
};
use asus_numpad::keycodes as kc;
use asus_numpad::layout::{Geometry, KeyMode, COLS, KEY_GRID, ROWS, UM_PER_LAYOUT_UNIT};
use asus_numpad::{banner, verification_notice};

#[derive(Parser, Debug)]
#[command(
    name = "asus-numpad",
    version,
    about = "ASUS 触摸板数字小键盘驱动（Linux，官方 AlgoParameters 对齐版）",
    long_about = None
)]
struct Cli {
    /// 配置文件路径
    #[arg(long, global = true, value_name = "PATH")]
    config: Option<String>,

    /// 触摸板事件设备；缺省自动探测（ASUF1416:00 28 08:0108）
    #[arg(long, global = true, value_name = "DEV")]
    device: Option<String>,

    /// 键盘事件设备（读 NumLock LED）
    #[arg(long, global = true, value_name = "DEV")]
    keyboard: Option<String>,

    /// 背光通道：hidraw / i2c / none
    #[arg(long, global = true, value_name = "KIND")]
    led: Option<String>,

    /// i2c 总线号
    #[arg(long, global = true)]
    i2c_bus: Option<i32>,

    /// i2c 地址（0x38 或 56）
    #[arg(long, global = true)]
    i2c_addr: Option<String>,

    /// hidraw 节点（如 /dev/hidraw3）
    #[arg(long, global = true)]
    hidraw: Option<String>,

    /// i2c 写入工具名
    #[arg(long, global = true)]
    i2c_transfer: Option<String>,

    /// 键位风格：keypad / digits
    #[arg(long, global = true, value_name = "MODE")]
    key_mode: Option<String>,

    /// 布局代号（目前仅 GH3XLNDZ 有线框数据）
    #[arg(long, global = true)]
    layout: Option<String>,

    /// NumLock 联动：sync / toggle / off
    #[arg(long, global = true, value_name = "MODE")]
    numlock: Option<String>,

    /// 混合模式：auto / on / off
    #[arg(long, global = true, value_name = "MODE")]
    mixed_mode: Option<String>,

    /// 小键盘态最小压力（0 = 不过滤）
    #[arg(long, global = true)]
    pressure_min: Option<i32>,

    /// 关闭「数字区亮度跟随键盘背光」，退回固定 0x01 点亮
    #[arg(long, global = true, action = ArgAction::SetTrue)]
    no_follow_brightness: bool,

    /// 抓取触摸板（默认开启）
    #[arg(long, global = true, action = ArgAction::SetTrue)]
    grab: bool,

    /// 不抓取触摸板（数字区点击会穿透到桌面）
    #[arg(long, global = true, action = ArgAction::SetTrue, conflicts_with = "grab")]
    no_grab: bool,

    /// 打印默认配置后退出
    #[arg(long, global = true)]
    dump_config: bool,

    /// 输出逐帧调试日志（run 模式）
    #[arg(long, short, global = true, action = ArgAction::SetTrue)]
    verbose: bool,

    #[command(subcommand)]
    cmd: Option<Cmd>,
}

#[derive(Subcommand, Debug)]
enum Cmd {
    /// 接管触摸板（默认动作）
    Run,
    /// 自检：打印官方参数、几何换算、键位图，并跑离线用例
    Check,
    /// 原样打印触摸板事件（排障用，不产生按键）
    Dump,
    /// 亮度调节：三档手动调光 / 是否跟随键盘背光
    ///
    /// 例：`bright 1|2|3`（0 = 熄灭）、`bright follow on|off`、`bright status`
    Bright {
        /// 档位（0/1/2/3）或 `follow` / `status`
        #[arg(value_name = "LEVEL|follow|status")]
        value: Option<String>,

        /// `follow` 的取值：on / off
        #[arg(value_name = "on|off")]
        mode: Option<String>,
    },
}

fn detect_led_kind() -> String {
    // 无显式指定时：有 hidraw 节点就用 hidraw，否则 i2c
    let has_hidraw = std::fs::read_dir("/dev")
        .map(|d| {
            d.flatten()
                .any(|e| e.file_name().to_string_lossy().starts_with("hidraw"))
        })
        .unwrap_or(false);
    if has_hidraw {
        "hidraw".to_string()
    } else {
        "i2c".to_string()
    }
}

fn build_config(cli: &Cli) -> (Config, Vec<String>, std::path::PathBuf) {
    let path = cli
        .config
        .clone()
        .map(std::path::PathBuf::from)
        .unwrap_or_else(Config::default_path);
    let (mut cfg, mut notes) = Config::load(&path);

    if let Some(v) = &cli.key_mode {
        match v.parse::<KeyMode>() {
            Ok(m) => cfg.key_mode = m,
            Err(_) => notes.push(format!("--key-mode={v} 无效，忽略")),
        }
    }
    if let Some(v) = &cli.layout {
        cfg.layout_name = v.clone();
    }
    if let Some(v) = &cli.numlock {
        cfg.numlock = match v.as_str() {
            "sync" => NumLockMode::Sync,
            "toggle" => NumLockMode::Toggle,
            "off" => NumLockMode::Off,
            _ => {
                notes.push(format!("--numlock={v} 无效，忽略"));
                cfg.numlock
            }
        };
    }
    if let Some(v) = &cli.mixed_mode {
        cfg.mixed_mode = match v.as_str() {
            "auto" => MixedMode::Auto,
            "on" | "true" => MixedMode::On,
            "off" | "false" => MixedMode::Off,
            _ => {
                notes.push(format!("--mixed-mode={v} 无效，忽略"));
                cfg.mixed_mode
            }
        };
    }
    if let Some(v) = cli.pressure_min {
        cfg.pressure_numpad_min = v.max(0);
    }
    if cli.no_follow_brightness {
        cfg.follow_keyboard_brightness = false;
    }
    if cli.grab {
        cfg.grab = true;
    }
    if cli.no_grab {
        cfg.grab = false;
    }
    if let Some(v) = &cli.device {
        cfg.device_override = Some(v.clone());
    }
    if let Some(v) = &cli.keyboard {
        cfg.keyboard_override = Some(v.clone());
    }
    if let Some(v) = &cli.led {
        cfg.led_kind = v.clone();
    } else {
        cfg.led_kind = detect_led_kind();
    }
    if let Some(v) = cli.i2c_bus {
        cfg.i2c_bus = Some(v);
    }
    if let Some(v) = &cli.i2c_addr {
        cfg.i2c_addr = parse_addr(v).or_else(|| {
            notes.push(format!("--i2c-addr={v} 无法解析，忽略"));
            cfg.i2c_addr
        });
    }
    if let Some(v) = &cli.hidraw {
        cfg.hidraw = Some(v.clone());
    }
    if let Some(v) = &cli.i2c_transfer {
        cfg.i2c_transfer = v.clone();
    }
    notes.extend(cfg.sanitize());
    (cfg, notes, path)
}

fn parse_addr(s: &str) -> Option<u8> {
    let s = s.trim();
    if let Some(hex) = s.strip_prefix("0x").or_else(|| s.strip_prefix("0X")) {
        u8::from_str_radix(hex, 16).ok()
    } else {
        s.parse::<u8>().ok()
    }
}

fn render_keygrid(cfg: &Config) -> String {
    let mut out = String::new();
    for (r, row) in KEY_GRID.iter().enumerate() {
        let mut line = format!("  行{r}: ");
        for (c, cell) in row.iter().enumerate() {
            let text = match cell {
                None => "NumLock图标".to_string(),
                Some(cell) => {
                    let key = asus_numpad::layout::key_for_cell(*cell, cfg.key_mode)
                        .map(|k| kc::name_of(k).to_string())
                        .unwrap_or_else(|| "?".into());
                    key
                }
            };
            line.push_str(&format!("[列{c} {text}] "));
        }
        out.push_str(&line);
        out.push('\n');
    }
    out
}

fn fallback_geometry(cfg: &Config) -> Geometry {
    // 无真机时用配置里的物理尺寸构造一个 0..1000 的虚拟坐标系
    let width_um = cfg.touchpad_width_mm * 1000.0;
    let height_um = cfg.touchpad_height_mm * 1000.0;
    let ux = 1000.0 / width_um;
    let uy = 1000.0 / height_um;
    Geometry::new(0, 1000, 0, 1000, ux, uy, cfg.layout())
}

fn cmd_check(cfg: &Config, notes: &[String]) -> Result<i32> {
    println!("{}", banner());
    println!("{}", verification_notice());
    println!();
    if !notes.is_empty() {
        println!("配置提示：");
        for n in notes {
            println!("  - {n}");
        }
        println!();
    }

    println!("配置摘要：{}", cfg.summary());
    println!();
    println!("官方 AlgoParameters（INF 原值）：");
    for (name, value) in config::official_parameters() {
        println!("  {name:<32} {value}");
    }
    println!();

    let geometry = {
        #[cfg(target_os = "linux")]
        {
            match asus_numpad::linux::probe_report(cfg) {
                Ok((g, lines)) => {
                    println!("设备：已探测到触摸板，使用真实分辨率");
                    for line in lines {
                        println!("  {line}");
                    }
                    g
                }
                Err(e) => {
                    println!("设备：未探测到触摸板（{e}），改用配置尺寸 {:.0}x{:.0} mm 估算",
                        cfg.touchpad_width_mm, cfg.touchpad_height_mm);
                    fallback_geometry(cfg)
                }
            }
        }
        #[cfg(not(target_os = "linux"))]
        {
            println!(
                "设备：当前平台非 Linux，使用配置尺寸 {:.0}x{:.0} mm 估算",
                cfg.touchpad_width_mm, cfg.touchpad_height_mm
            );
            fallback_geometry(cfg)
        }
    };

    println!();
    println!("几何换算（官方单位 {} µm）：", UM_PER_LAYOUT_UNIT);
    println!("  {}", geometry.describe());
    println!(
        "  有效区 x[{:.0},{:.0}] y[{:.0},{:.0}]",
        geometry.usable_x0, geometry.usable_x1, geometry.usable_y0, geometry.usable_y1
    );
    println!();
    println!("键位图（{} 列 x {} 行，key_mode={}）：", COLS, ROWS, cfg.key_mode.as_str());
    print!("{}", render_keygrid(cfg));

    println!();
    println!("各格中心与命中键：");
    for r in 0..ROWS {
        for c in 0..COLS {
            let (cx, cy) = geometry.cell_center(r, c);
            let key = geometry
                .key_at(
                    cx.round() as i32,
                    cy.round() as i32,
                    cfg.key_mode,
                    cfg.tap_threshold_mm,
                    cfg.tap_threshold_mm * 1000.0 * geometry.ux,
                    cfg.tap_threshold_mm * 1000.0 * geometry.uy,
                )
                .map(|k| kc::name_of(k).to_string())
                .unwrap_or_else(|| "None".into());
            println!("  ({r},{c}) 中心=({cx:.0},{cy:.0}) → {key}");
        }
    }

    println!();
    println!("行为开关：");
    println!("  NumLock 联动      {}（长按 {} 帧 = {} ms）",
        cfg.numlock.as_str(), cfg.numlock_frames(), cfg.numlock_frames() * cfg.frame_ms);
    println!("  混合模式          {}（GESTURE_00 支持位 = 1）", cfg.mixed_mode.as_str());
    println!("  计算器长按        {}（{} 帧 = {} ms）",
        if cfg.calc_gesture && cfg.calc_gesture_mode == CalcMode::Long { "启用" } else { "关闭" },
        cfg.numadv_trigger_frames, cfg.numadv_trigger_frames * cfg.frame_ms);
    println!("  抓取触摸板        {}", if cfg.grab { "是" } else { "否（点击会穿透）" });
    println!("  空闲熄灯          {}s（熄灯不退出，触摸复亮）", cfg.max_work_time_ms / 1000);
    println!("  背光通道          {}（{}）", cfg.led_kind, if cfg.led_kind == "hidraw" {
        cfg.hidraw.clone().unwrap_or_else(|| "自动探测".into())
    } else {
        match (cfg.i2c_bus, cfg.i2c_addr) {
            (Some(b), Some(a)) => format!("bus={b} addr=0x{a:02x}"),
            _ => "自动探测".into(),
        }
    });

    println!("  背光亮度          {}", brightness_report(cfg));
    println!("  调光命令          asus-numpad bright 1|2|3（0=灭）；asus-numpad bright follow on|off");
    println!();
    println!("离线用例：见 `cargo test`（Windows / Linux 均可运行，不依赖硬件）");
    println!("自检结论：配置与几何自洽；真机行为仍需实机确认。");
    Ok(0)
}

/// 键盘背光 → 数字区亮度档的当前换算结果（`check` / `run` 启动横幅用）。
fn brightness_report(cfg: &Config) -> String {
    let levels = cfg.effective_levels();
    if levels.is_empty() {
        return format!(
            "不跟随键盘背光，固定档 {} → 0x{:02x}（`bright 1|2|3` 调整，`bright follow on` 恢复跟随）",
            cfg.manual_brightness_step,
            cfg.static_on_value()
        );
    }
    let mut follower = asus_numpad::brightness::BrightnessFollower::new(
        &cfg.keyboard_brightness_dir,
        levels.clone(),
    );
    let level = follower.on_value();
    match follower.last_kbd {
        Some(kbd) => format!(
            "跟随键盘背光 {kbd}/{} → 0x{level:02x}（{} 档，{} ms 轮询，{})",
            follower.max_kbd().max(1),
            levels.len(),
            cfg.brightness_poll_ms,
            follower.dir().display()
        ),
        None => format!(
            "跟随键盘背光（读不到 {}，退回 0x{level:02x} 点亮）",
            follower.dir().display()
        ),
    }
}

/// 打印三档亮度 / 跟随开关的当前状态。
fn print_bright_status(cfg: &Config) {
    println!("跟随键盘背光：{}", if cfg.follow_keyboard_brightness {
        "开（数字区亮度随键盘背光自动变化）"
    } else {
        "关（使用手动固定档）"
    });
    println!("键盘背光目录：{}（轮询 {} ms）", cfg.keyboard_brightness_dir, cfg.brightness_poll_ms);
    println!("手动固定档：{}（0=灭，1=暗，2=中，3=亮）", cfg.manual_brightness_step);

    let mut table = Vec::new();
    for step in 1..=MANUAL_BRIGHTNESS_STEPS {
        let v = cfg.level_for_step(step).unwrap_or(VAL_OFF);
        table.push(format!("{step}→0x{v:02x}"));
    }
    println!("三档映射：0→0x{:02x}（灭）；{}", VAL_OFF, table.join("，"));
    println!("生效点灯值：{}", brightness_report(cfg));

    let mut follower = asus_numpad::brightness::BrightnessFollower::new(
        &cfg.keyboard_brightness_dir,
        cfg.manual_levels(),
    );
    let cur = follower.on_value();
    match follower.last_kbd {
        Some(kbd) => println!(
            "键盘背光实测：{kbd}/{} → 数字区 0x{cur:02x}",
            follower.max_kbd().max(1)
        ),
        None => println!(
            "键盘背光实测：读不到 {}（非 ASUS 机型 / asus-wmi 未加载）",
            follower.dir().display()
        ),
    }
}

/// 只改配置文件里的亮度相关键，其余字段原样保留；写前留 `.bak` 备份。
fn persist_bright_setting(path: &Path, follow: Option<bool>, step: Option<u8>) -> Result<PathBuf> {
    let base = match std::fs::read_to_string(path) {
        Ok(text) => text,
        // 配置文件不存在：以默认配置为底再写入差异项
        Err(_) => Config::default().to_json(),
    };
    let mut value: serde_json::Value = serde_json::from_str(&base).with_context(|| {
        format!("{} 不是合法 JSON，已中止（未做任何修改）", path.display())
    })?;
    if !value.is_object() {
        value = serde_json::json!({});
    }
    if let Some(on) = follow {
        value["follow_keyboard_brightness"] = serde_json::json!(on);
    }
    if let Some(step) = step {
        value["manual_brightness_step"] = serde_json::json!(step);
    }
    let mut text = serde_json::to_string_pretty(&value)?;
    text.push('\n');

    if let Some(dir) = path.parent() {
        if !dir.as_os_str().is_empty() {
            std::fs::create_dir_all(dir)
                .with_context(|| format!("无法创建目录 {}", dir.display()))?;
        }
    }
    let backup = PathBuf::from(format!("{}.bak", path.display()));
    if path.exists() {
        std::fs::copy(path, &backup)
            .with_context(|| format!("备份 {} 失败，已中止", path.display()))?;
    }
    std::fs::write(path, text)
        .with_context(|| format!("写入 {} 失败（需要 root 权限？）", path.display()))?;
    Ok(backup)
}

/// 直接下发一个亮度字节到背光通道；返回是否成功。
fn apply_led_level(cfg: &Config, level: u8) -> bool {
    #[cfg(target_os = "linux")]
    {
        let mut led = asus_numpad::linux::led::build_led(cfg);
        let ok = led.send(level);
        if ok {
            println!("已下发亮度 0x{level:02x}（通道 {}）", cfg.led_kind);
        } else {
            println!(
                "下发 0x{level:02x} 失败：通道不通（检查 --hidraw 节点、udev 规则或是否需 root）"
            );
        }
        ok
    }
    #[cfg(not(target_os = "linux"))]
    {
        let _ = (cfg, level);
        println!("当前平台非 Linux，不下发报文（仅展示换算结果）。");
        false
    }
}

/// 若 asus-numpad 服务正在运行，就重启它让新配置立即生效；未运行时只提示，不主动拉起。
fn try_restart_service() {
    let active = std::process::Command::new("systemctl")
        .args(["is-active", "--quiet", "asus-numpad"])
        .status()
        .map(|s| s.success())
        .unwrap_or(false);
    if !active {
        println!("提示：asus-numpad 服务未在运行，下次启动时按新配置生效。");
        return;
    }
    match std::process::Command::new("systemctl")
        .args(["restart", "asus-numpad"])
        .status()
    {
        Ok(s) if s.success() => println!("已重启 asus-numpad 服务，新设置立即生效。"),
        _ => println!(
            "自动重启服务失败（多半是权限），请手动执行：sudo systemctl restart asus-numpad"
        ),
    }
}

/// 落盘 + 立即下发 + 让服务按新档重跑（`bright 1|2|3`、`up|down|cycle` 共用）。
fn apply_step(cfg: &Config, cfg_path: &Path, step: u8) -> Result<i32> {
    let Some(level) = cfg.level_for_step(step) else {
        println!("档位 {step} 无法换算成亮度字节（检查 brightness_levels 配置）");
        return Ok(2);
    };
    let ok = apply_led_level(cfg, level);
    // 手动选档等价于「不跟随键盘背光」：否则键盘背光一变就会把手动档覆盖掉
    let backup = persist_bright_setting(cfg_path, Some(false), Some(step))?;
    println!(
        "已写入 {}：manual_brightness_step = {step}，follow_keyboard_brightness = false（备份 {}）",
        cfg_path.display(),
        backup.display()
    );
    if level == VAL_OFF {
        println!("效果：数字区熄灭（bright 1|2|3 可重新点亮）。");
    } else {
        println!("效果：数字区固定 0x{level:02x}（不再随键盘背光变化）。");
    }
    try_restart_service();
    Ok(if ok { 0 } else { 1 })
}

/// `bright`：手动三档调光 + 是否跟随键盘背光。
fn cmd_bright(cfg: &Config, cfg_path: &Path, value: Option<&str>, mode: Option<&str>) -> Result<i32> {
    let value = value.map(|v| v.trim().to_ascii_lowercase());
    match value.as_deref() {
        None | Some("status") => {
            print_bright_status(cfg);
            Ok(0)
        }
        Some("follow") => {
            let on = match mode.map(|m| m.trim().to_ascii_lowercase()).as_deref() {
                Some("on") | Some("true") | Some("1") | Some("yes") => true,
                Some("off") | Some("false") | Some("0") | Some("no") => false,
                _ => {
                    println!("用法：asus-numpad bright follow on|off");
                    return Ok(2);
                }
            };
            let backup = persist_bright_setting(cfg_path, Some(on), None)?;
            println!(
                "已写入 {}：follow_keyboard_brightness = {}（备份 {}）",
                cfg_path.display(),
                on,
                backup.display()
            );
            if on {
                println!("效果：数字区亮度重新跟随键盘背光（键盘背光一变化即同步）。");
            } else {
                println!(
                    "效果：数字区改用固定档 {}（0x{:02x}），键盘背光变化不再影响数字区。",
                    cfg.manual_brightness_step,
                    cfg.static_on_value()
                );
            }
            try_restart_service();
            Ok(0)
        }
        Some("cycle") | Some("next") => {
            let cur = cfg.manual_brightness_step;
            let next = if cur == 0 || cur >= MANUAL_BRIGHTNESS_STEPS { 1 } else { cur + 1 };
            println!("切换档位：{cur} → {next}");
            apply_step(cfg, cfg_path, next)
        }
        Some("up") | Some("+") => {
            let cur = cfg.manual_brightness_step.clamp(1, MANUAL_BRIGHTNESS_STEPS);
            let next = (cur + 1).min(MANUAL_BRIGHTNESS_STEPS);
            println!("切换档位：{cur} → {next}（已是最高档会保持不变）");
            apply_step(cfg, cfg_path, next)
        }
        Some("down") | Some("-") => {
            let cur = cfg.manual_brightness_step.clamp(1, MANUAL_BRIGHTNESS_STEPS);
            let next = cur.saturating_sub(1).max(1);
            println!("切换档位：{cur} → {next}（最低档为 1，熄灭用 bright 0）");
            apply_step(cfg, cfg_path, next)
        }
        Some(other) => {
            let step: u8 = match other.parse::<u8>() {
                Ok(v) if v <= MANUAL_BRIGHTNESS_STEPS => v,
                _ => {
                    println!(
                        "用法：asus-numpad bright 0|1|2|3     固定档（0=灭，1=暗，2=中，3=亮）\n      \
asus-numpad bright up|down|cycle  三档循环切换\n      \
asus-numpad bright follow on|off  是否跟随键盘背光\n      \
asus-numpad bright status         查看当前状态"
                    );
                    return Ok(2);
                }
            };
            apply_step(cfg, cfg_path, step)
        }
    }
}

fn cmd_dump(cfg: &Config) -> Result<i32> {
    println!("{}", banner());
    println!("{}", verification_notice());
    println!("dump 模式：原样打印触摸板事件，不产生任何按键。按 Ctrl+C 退出。");
    println!("{}", cfg.summary());

    #[cfg(target_os = "linux")]
    {
        asus_numpad::linux::dump_events(cfg)?;
        Ok(0)
    }
    #[cfg(not(target_os = "linux"))]
    {
        println!("当前平台不支持 evdev，无法 dump。请在目标 Linux 机器上运行。");
        Ok(1)
    }
}

fn cmd_run(cfg: Config, verbose: bool) -> Result<i32> {
    println!("{}", banner());
    println!("{}", verification_notice());
    println!("{}", cfg.summary());
    println!("背光亮度：{}", brightness_report(&cfg));

    #[cfg(target_os = "linux")]
    {
        asus_numpad::linux::run_service(cfg, verbose)?;
        Ok(0)
    }
    #[cfg(not(target_os = "linux"))]
    {
        let _ = (cfg, verbose);
        println!("当前平台不支持 evdev / uinput，run 仅能在 Linux 上运行。");
        println!("可用 `asus-numpad check` 查看参数与几何换算。");
        Ok(1)
    }
}

fn main() -> Result<()> {
    let cli = Cli::parse();
    let (cfg, notes, cfg_path) = build_config(&cli);

    if cli.dump_config {
        println!("{}", cfg.to_json());
        return Ok(());
    }

    let code = match cli.cmd.unwrap_or(Cmd::Run) {
        Cmd::Check => cmd_check(&cfg, &notes)?,
        Cmd::Dump => cmd_dump(&cfg)?,
        Cmd::Bright { value, mode } => cmd_bright(&cfg, &cfg_path, value.as_deref(), mode.as_deref())?,
        Cmd::Run => cmd_run(cfg, cli.verbose)?,
    };
    if code != 0 {
        std::process::exit(code);
    }
    Ok(())
}
