param.numlock_gh3 = {frames} frames = {ms} ms (this model)
param.led_values = off 0x{off}; on: follows keyboard backlight 0x41..0x48, falls back to 0x{on} when unreadable (hidraw FEATURE 0x0d)
param.i2c_unlock = 0x{unlock} (i2c channel only; brightness steps 0x41..0x48)
param.i2c_unlock_name = i2c unlock word
param.led_values_name = LED values
param.key_count = Virtual keyboard key count

