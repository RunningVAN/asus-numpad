# ---- Layouts (v8: cross-model support) ----
cli.allow_unverified.help = Allow keys from layouts not yet verified on real hardware (blocked by default to avoid wrong keys)
cli.allow_sku_mismatch.help = Also start when the machine model does not match (blocked by default to avoid wrong-model packages)
cli.cmd.layout = Layout: list official layouts / auto-detect by HID hardware ID / pin a layout
cli.cmd.layout.long = Without arguments it lists every official layout with its support level; `layout auto` restores auto-detection; `layout GH3XLNDZ` pins a layout; `layout --ids` also prints the HID hardware ID table
cli.cmd.layout.name = Layout name (GH3XLNDZ / GH2XLNDZ / GH4XLNDZ / auto)
cli.cmd.layout.ids = Also list the touchpad HID hardware ID -> layout table
layout.current = Layout: configured {layout}, effective {resolved} ({support})
layout.list_title = Layouts recorded in the official AsusNUMPADFilter.inf (* verified / ~ family unverified / - different structure):
layout.legend = * verified   ~ same family, unverified (needs --allow-unverified)   - unsupported
layout.ids_title = Touchpad HID hardware ID -> layout (models sharing an ID are interchangeable):
layout.usage = Usage: asus-numpad layout                 show current layout and the table
      asus-numpad layout --ids           also print the HID hardware ID table
      asus-numpad layout auto            auto-detect from the touchpad HID ID (recommended)
      asus-numpad layout GH3XLNDZ        pin a layout
layout.wrote = Wrote {path}: layout_name = {value} (backup {backup})
layout.effect_auto = Next start picks the layout from the touchpad HID hardware ID, falling back to GH3XLNDZ
layout.unverified_warn = Note: layout {layout} is {support}; its key table has not been verified on real hardware
layout.bad_name = Unknown layout name: {v}
note.layout_unknown = layout_name={v} is not in the official layout table, using auto
err.layout_unverified = Layout {layout} ({support}) is not verified on real hardware; startup stopped to avoid wrong keys. Add --allow-unverified once confirmed.
err.layout_unverified.hint = To allow it: asus-numpad --allow-unverified run, or set "allow_unverified_layout": true in ~/.config/asus-numpad/asus-numpad.json
err.layout_unsupported.hint = This layout's key table differs from GH3XLNDZ and would produce wrong keys; please report the `asus-numpad check` output so the key table can be added
dev.report.layout = Layout: {layout} ({support}, source {source}, HID {hid})

# 跨机型背光自检 / cross-model backlight self-check
