# asus-numpad English language file
# Format: key = text (# starts a comment, \n is allowed inside a value)
# Missing keys fall back to the built-in English text; copy this file to ~/.config/asus-numpad/lang/ to override (no root needed).

# ---- 启动横幅 ----
app.banner = ASUS touchpad numpad v{version} (Linux userspace, aligned with official AlgoParameters)

# ---- 命令行总览 ----
cli.about = ASUS touchpad numpad driver (Linux, aligned with official AlgoParameters)
cli.config.help = Path to the config file
cli.device.help = Touchpad event device; auto-detected by default (ELAN 04F3 / PixArt 093A, layout picked from the HID module)
cli.keyboard.help = Keyboard event device (reads the NumLock LED)
cli.led.help = Backlight channel: hidraw / i2c / none
cli.i2c_bus.help = i2c bus number
cli.i2c_addr.help = i2c address (0x38 or 56)
cli.hidraw.help = hidraw node (e.g. /dev/hidraw3)
cli.i2c_transfer.help = i2c write tool name
cli.key_mode.help = Key style: keypad / digits
cli.layout.help = Layout code (only GH3XLNDZ has wireframe data so far)
cli.numlock.help = NumLock linkage: sync / toggle / off
cli.mixed_mode.help = Mixed mode: auto / on / off
cli.pressure_min.help = Minimum pressure in numpad mode (0 = no filtering)
cli.no_follow_brightness.help = Disable "numpad brightness follows keyboard backlight" and fall back to fixed 0x01
cli.grab.help = Grab the touchpad (default)
cli.no_grab.help = Do not grab the touchpad (numpad clicks leak to the desktop)
cli.dump_config.help = Print the default config and exit
cli.verbose.help = Print per-frame debug logs (run mode)
cli.lang.help = UI language: zh-CN / zh-TW / en / auto (default auto = follow system)

# ---- 子命令说明 ----
cli.cmd.run = Take over the touchpad (default action)
cli.cmd.check = Self-check: print official parameters, geometry conversion, key map, and run offline cases
cli.cmd.dump = Print raw touchpad events (troubleshooting, no key output)
cli.cmd.bright = Brightness: four manual steps (0..max, linear or custom) / follow keyboard backlight
cli.cmd.bright.long = e.g. `bright 0|1|2|3|4` (0 = off, 1 = darkest, 4 = brightest, linearly spaced by default), `bright up|down|cycle`, `bright follow on|off`, `bright status`; define your own steps with the `manual_brightness_levels` config key
cli.cmd.bright.value = Step 0/1/2/3/4 (bounded by a custom step table), or up / down / cycle / next / follow / status
cli.cmd.bright.mode = Value for `follow`: on / off
cli.cmd.led = Send a raw backlight command byte (bypasses every state machine; for diagnosis)
cli.cmd.led.long = e.g. led on | led off | led 0x41..0x48 (levels 1..8). Separates "never sent" from "hardware rejects".
cli.cmd.led.value = on / off / any hex level (e.g. 0x41)
led.cmd.usage = Usage: asus-numpad led on|off|0x41 (0x01 = on, 0x00 = off, 0x41..0x48 = levels 1..8)
led.cmd.bad_value = Unrecognized value: {v} (use on / off / 0x41 / 65)
cli.cmd.lang = Language: show / switch the UI language (简体中文, 繁體中文, English)
cli.cmd.lang.long = e.g. `lang` (show current language and source), `lang zh-TW`, `lang en`, `lang auto` (follow system)
cli.cmd.lang.code = Language code: zh-CN / zh-TW / en / auto

# ---- 命令行参数取值无效时的提示 ----
note.invalid_key_mode = --key-mode={v} is invalid, ignored
note.invalid_numlock = --numlock={v} is invalid, ignored
note.invalid_mixed_mode = --mixed-mode={v} is invalid, ignored
note.invalid_i2c_addr = --i2c-addr={v} cannot be parsed, ignored
note.invalid_language = language={v} is not recognised, falling back to auto
note.manual_step_clamped = manual_brightness_step={step} is outside 0..={max}, clamped to {max}
note.levels_dropped = {n} entr(y/ies) in brightness_levels are outside 0x{lo}..=0x{hi} and were dropped
note.manual_levels_dropped = {n} entr(y/ies) in manual_brightness_levels are neither 0 (off) nor inside 0x{lo}..=0x{hi} and were dropped
note.manual_levels_not_increasing = manual_brightness_levels must increase strictly from dim to bright; custom table dropped, falling back to linear spacing
note.manual_levels_truncated = manual_brightness_levels has {n} steps, above the hardware limit of {max}; truncated
note.manual_levels_reset = manual_brightness_levels is empty after dropping out-of-range values; falling back to linear spacing
note.numlock_zone = numlock_zone={v} is no longer supported, treating it as a whole cell
note.read_failed = Failed to read {path}, using defaults: {err}
note.config_migrated = Migrated legacy config {from} to {to} (old file kept, safe to delete)

# ---- 配置摘要与官方参数 ----
