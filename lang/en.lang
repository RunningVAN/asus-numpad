# ---- 亮度状态 ----
bright.follow_switch = Follow keyboard backlight: {state}
bright.follow_on = on (numpad brightness tracks the keyboard backlight)
bright.follow_off = off (uses the manual fixed step)
bright.status_dir = Keyboard backlight dir: {dir} (polling {ms} ms)
bright.status_step = Manual fixed step: {step}/{steps} (0=off, 1=darkest, {steps}=brightest)
bright.status_map = Step mapping: 0→0x{off} (off); {table}
bright.status_effective = Effective LED value: {text}
bright.measured = Measured keyboard backlight: {kbd}/{max} → numpad 0x{cur}
bright.measure_failed = Measured keyboard backlight: cannot read {dir} (not an ASUS model / asus-wmi not loaded)
bright.report.follow = Follows keyboard backlight {kbd}/{max} → 0x{level} ({n} steps, {ms} ms polling, {dir})
bright.report.follow_nodir = Follows keyboard backlight (cannot read {dir}, falling back to 0x{level})
bright.report.static = Does not follow the keyboard backlight, fixed step {step} → 0x{level} (adjust with `bright 1..N`, re-enable with `bright follow on`)
bright.report.no_levels = Cannot read backlight node ({dir}), numpad falls back to 0x{level}

# ---- 亮度命令 ----
bright.usage = Usage: asus-numpad bright 0|1..N    fixed step (0=off; 1=darkest; N=brightest, N=4 by default, linearly spaced)\n       asus-numpad bright up|down|cycle  step up/down or cycle through all steps\n       asus-numpad bright follow on|off  follow the keyboard backlight or not\n       asus-numpad bright status         show the current state and step table
bright.follow_usage = Usage: asus-numpad bright follow on|off
bright.err_unmappable = Step {step} cannot be mapped to a brightness byte (check the brightness_levels config)
bright.sent = Sent brightness 0x{level} (channel {kind})
bright.send_failed = Failed to send 0x{level}: channel not usable (check the --hidraw node and whether the udev uaccess rule matches it)
bright.nonlinux = Not on Linux, no report is sent (showing conversion result only).
bright.wrote_step = Wrote {path}: manual_brightness_step = {step}, follow_keyboard_brightness = false (backup {backup})
bright.wrote_follow = Wrote {path}: follow_keyboard_brightness = {on} (backup {backup})
bright.effect_off = Result: numpad is off (use bright 1..N to light it again).
bright.effect_fixed = Result: numpad fixed at 0x{level} (no longer follows the keyboard backlight).
bright.effect_follow_on = Result: numpad brightness follows the keyboard backlight again (synced on every change).
bright.effect_follow_off = Result: numpad uses fixed step {step} (0x{level}); keyboard backlight changes no longer affect it.
bright.switch = Switching step: {from} → {to}
bright.switch_up = Switching step: {from} → {to} (stays unchanged at the highest step)
bright.switch_down = Switching step: {from} → {to} (lowest step is 1, use bright 0 to turn off)

